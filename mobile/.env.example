# Copy to .env for local development. For EAS builds, set these with
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value ... --visibility plaintext
# (EXPO_PUBLIC_* values are bundled into the app — never put secret keys here.)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: account Apple's reviewers sign in with (password shown in App Review notes)
EXPO_PUBLIC_REVIEW_EMAIL=appreview@yourdomain.com

EXPO_PUBLIC_PRIVACY_URL=https://yourdomain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
